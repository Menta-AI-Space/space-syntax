# PostgreSQL (PostGIS)
# Local-dev placeholder only — do NOT let a host's "fill from .env.example"
# convenience (e.g. Railway) turn this into your production DATABASE_URL.
# Set the real value directly in that host's environment/dashboard instead.
POSTGRES_DB=spacesyntax
POSTGRES_USER=spacesyntax
POSTGRES_PASSWORD=spacesyntax
DATABASE_URL=postgresql://spacesyntax:spacesyntax@localhost:5432/spacesyntax

# Kakao Developers — https://developers.kakao.com/
# REST API key (Local API for geocoding)
KAKAO_REST_KEY=your_kakao_rest_api_key_here
DEPTHMAPX_COMMAND=
DEPTHMAPX_ENABLED=true
DEPTHMAPX_TIMEOUT_SECONDS=180
INTERACTIVE_MAX_SEGMENTS=1000
# Persistent baseline cache. Bump NETWORK_VERSION whenever roads_clean is rebuilt.
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_NETWORK_VERSION=roads-clean-v1
ANALYSIS_CACHE_VERSION=angular-analysis-v1
ANALYSIS_CACHE_MAX_ENTRIES=10000

# Korean Public Data Portal — https://www.data.go.kr/
# Real estate transaction APIs (RTMSDataSvcNrgTrade, RTMSDataSvcAptTrade, RTMSDataSvcOffiTrade)
# SBIZ commercial store API (소상공인시장진흥공단_상가(상권)정보_API — storeListInRadius, etc.)
DATA_GO_API_KEY=your_key_here

# JavaScript key for Kakao Maps (set in frontend/index.html or via env at build time)
KAKAO_JS_KEY=your_kakao_javascript_key_here

# VWorld — https://www.vworld.kr/ (land use zone lookup)
VWORLD_API_KEY=your_vworld_api_key_here
VWORLD_DOMAIN=localhost
OSM_PBF_PATH=data/osm/seoul-small.osm.pbf  # 서대문구 bbox extract (legacy filename)

# Full/regional PBF used only by prepare_sample_osm.ps1 and import_osm_full.ps1.
# Local one-off script input, not read by the app — leave unset on a deploy host.
OSM_PBF_FULL_PATH=C:\path\to\south-korea-latest.osm.pbf

# SGIS (KOSTAT Statistical Geographic Information Service) - sgis.kostat.go.kr
# Used for population/household/worker demand stats (site score)
SGIS_CONSUMER_KEY=your_sgis_consumer_key_here
SGIS_CONSUMER_SECRET=your_sgis_consumer_secret_here

# SGIS grid radius aggregation reads from Postgres/PostGIS (sgis_grid_cells /
# sgis_grid_stats tables), not from a local folder. Load them once from a
# merged census CSV + boundary shapefile bundle via:
#   backend/.venv/Scripts/python.exe -m scripts.import_sgis_grid --data-dir "C:\path\to\sgis-grid"
# (defaults to ../data/sgis-grid relative to backend/ and DATABASE_URL above)

# Seoul Open Data — https://data.seoul.go.kr/ (상권분석서비스, trending streets shortcut)
DATA_SEOUL_GO_API_KEY=

# 오피넷(한국석유공사) 무료 API — https://www.opinet.co.kr (주유소 fuel_price_position KPI,
# 일 1,500회; gas_station 프로파일 분석 요청 시에만 호출 + 1h 캐시)
OPINET_API_KEY=

# OpenAI API - natural-language site score explanation (optional; rule-based fallback without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- API access control (backend/app/security.py) ---
# Empty (default) leaves the API open with no key required. Set this on any
# deploy host to require X-API-Key on every request.
API_ACCESS_TOKEN=
# Comma-separated. Must list the exact origin(s) the frontend is served from.
# Railway seeds service variables from this file, so the deployed frontend's
# origins must stay listed here — dropping them makes every browser call from
# the deployed site fail preflight with "Disallowed CORS origin".
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://real-estate-79e2a.web.app,https://real-estate-79e2a.firebaseapp.com
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=6
# Only set true once a reverse proxy that overwrites (not appends to)
# X-Forwarded-For sits in front of this app — see backend/app/security.py.
TRUST_FORWARDED_FOR=false

# --- Customer-facing Telegram analysis Agent ---
# Dedicated BotFather token for users who want the same /api/agent/ask result
# without opening the website. Do NOT reuse TELEGRAM_BOT_TOKEN from Hermes or
# the autonomous development runner: Telegram allows only one poller per token.
# Empty token disables this interface without affecting the backend.
TELEGRAM_AGENT_BOT_TOKEN=
# Comma-separated stable numeric Telegram user IDs. Empty fails closed.
TELEGRAM_AGENT_ALLOWED_IDS=

# --- Observability (backend/app/observability.py, logging_config.py) ---
LOG_LEVEL=INFO
SLOW_REQUEST_MS=5000
