{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.agent",
    "watchPatterns": [
      "Dockerfile.agent",
      "scripts/agent-entrypoint.sh",
      "backend/tools/agent/telegram_bot.py",
      "railway.agent.json",
      "backend/requirements.txt",
      "backend/requirements-dev.txt"
    ]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/agent-entrypoint.sh",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
