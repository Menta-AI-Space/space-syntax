# Empty means use the same-origin Next.js proxy at /api/[...path]. Set this to
# http://localhost:8000 only if you intentionally want browser-to-backend direct calls.
NEXT_PUBLIC_API_BASE_URL=

# Server-side target used by frontend-next/app/api/[...path]/route.ts.
BACKEND_API_BASE_URL=http://localhost:8000

# Kakao JavaScript key. Register http://localhost:3000 in Kakao Developers > Platform > Web.
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key_here
